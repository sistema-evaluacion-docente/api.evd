@startuml cu-17-sistema-verificacion-de-planes
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' =============================================================================
title Casos de uso del Sistema — Verificación automática de los planes\nRequisitos RF-4.1, RF-4.3, RF-6.4, RF-6.9 y RF-6.13

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Sistema" as SYS <<automático>> #FFF8E1

rectangle "Verificación del plan con los resultados del periodo siguiente" {
  usecase "Verificar los indicadores al procesar\nel periodo siguiente\n<size:10><color:#607D8B>RF-6.13</color></size>" as S11 #FFFDE7
  usecase "Medir el indicador contra\nla meta pactada\n<size:10><color:#607D8B>RF-6.9 · RF-6.13</color></size>" as S12 #FFFDE7
  usecase "Guardar el desglose por asignatura\n<size:10><color:#607D8B>RF-6.13</color></size>" as S13 #FFFDE7
  usecase "Cruzar los comentarios con las categorías\ndel compromiso al terminar el análisis\n<size:10><color:#607D8B>RF-6.13 · RF-4.1</color></size>" as S14 #FFFDE7
  usecase "Levantar alerta con un comentario\nde riesgo alto\n<size:10><color:#607D8B>RF-6.13</color></size>" as S15 #FFFDE7
  usecase "Re-verificar el plan al\nreclasificar un comentario\n<size:10><color:#607D8B>RF-6.13 · RF-4.3</color></size>" as S19 #FFFDE7
 
}

SYS --> S11
SYS --> S14
SYS --> S19

S11 ..> S12 : <<include>>
S12 ..> S13 : <<include>>
S14 ..> S15 : <<include>>

@enduml
