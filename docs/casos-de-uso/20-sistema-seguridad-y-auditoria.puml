@startuml cu-20-sistema-seguridad-y-auditoria
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' =============================================================================
title Casos de uso del Sistema — Seguridad, ámbito y auditoría\nRequisitos RF-1.1, RF-1.4, RF-1.5, RF-3.6 y RF-8.1

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Sistema" as SYS <<automático>> #FFF8E1
actor "Firebase Auth" as FBA <<externo>> #FFF3E0

rectangle "Seguridad, ámbito y auditoría" {
  usecase "Validar el token de identidad\n<size:10><color:#607D8B>RF-1.1</color></size>" as S31 #FFFDE7
  usecase "Autorizar según el rol del usuario\n<size:10><color:#607D8B>RF-1.4</color></size>" as S32 #FFFDE7
  usecase "Ocultar del menú lo que el\nrol no puede abrir\n<size:10><color:#607D8B>RF-1.4</color></size>" as S33 #FFFDE7
  usecase "Confinar a cada rol a su ámbito\n<size:10><color:#607D8B>RF-1.5</color></size>" as S34 #FFFDE7
  usecase "Verificar el permiso antes de\nentregar un archivo\n<size:10><color:#607D8B>RF-3.6</color></size>" as S35 #FFFDE7
  usecase "Registrar el evento de auditoría\nde cada mutación\n<size:10><color:#607D8B>RF-8.1</color></size>" as S36 #FFFDE7
}

SYS --> S32
SYS --> S33
SYS --> S34
SYS --> S35
SYS --> S36

S32 ..> S31 : <<include>>

S31 --> FBA

@enduml
