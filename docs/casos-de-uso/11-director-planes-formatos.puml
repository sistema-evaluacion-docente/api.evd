@startuml cu-11-director-planes-formatos
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' =============================================================================
title Casos de uso del Director — Planes de mejoramiento: formatos oficiales\nRequisitos RF-6.7 a RF-6.11

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Director de Departamento" as DIR

rectangle "Planes de mejoramiento: contenido y formatos oficiales" {
  usecase "Registrar el caso del programa\n(Formato 1)\n<size:10><color:#607D8B>RF-6.7</color></size>" as D44
  usecase "Elaborar el acta del Formato 2\n<size:10><color:#607D8B>RF-6.8</color></size>" as D45
  usecase "Cerrar el acta\n<size:10><color:#607D8B>RF-6.8</color></size>" as D46
  usecase "Registrar las notas de seguimiento\n(Formato 3)\n<size:10><color:#607D8B>RF-6.10</color></size>" as D47
  usecase "Generar y descargar los\nformatos oficiales\n<size:10><color:#607D8B>RF-6.11</color></size>" as D48
  usecase "Cargar la versión firmada del formato\n<size:10><color:#607D8B>RF-6.11</color></size>" as D49
  usecase "Eliminar la versión firmada\n<size:10><color:#607D8B>RF-6.11</color></size>" as D50
  usecase "Fijar la meta de cada\nindicador comprometido\n<size:10><color:#607D8B>RF-6.9</color></size>" as D61
}

DIR --> D44
DIR --> D45
DIR --> D46
DIR --> D47
DIR --> D48
DIR --> D49
DIR --> D50

D61 .> D45 : <<extend>>\n(el director fija\nsu propia meta)

@enduml
