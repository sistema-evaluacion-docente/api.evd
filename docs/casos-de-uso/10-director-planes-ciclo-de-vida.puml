@startuml cu-10-director-planes-ciclo-de-vida
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' =============================================================================
title Casos de uso del Director — Planes de mejoramiento: ciclo de vida\nRequisitos RF-6.1 a RF-6.5 y RF-6.13

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Director de Departamento" as DIR

rectangle "Planes de mejoramiento: detección y ciclo de vida" {
  usecase "Consultar los docentes en riesgo\ny los candidatos a plan\n<size:10><color:#607D8B>RF-6.1</color></size>" as D35
  usecase "Crear un plan con sus compromisos\ny las asignaturas involucradas\n<size:10><color:#607D8B>RF-6.2 · RF-6.3</color></size>" as D36
  usecase "Consultar los planes del departamento\n<size:10><color:#607D8B>RF-6.2</color></size>" as D37
  usecase "Editar un plan\n<size:10><color:#607D8B>RF-6.2</color></size>" as D38
  usecase "Eliminar un plan\n<size:10><color:#607D8B>RF-6.2</color></size>" as D39
  usecase "Cerrar el plan con su resultado\ny su observación\n<size:10><color:#607D8B>RF-6.4</color></size>" as D40
  usecase "Consultar el historial de\nplanes de un docente\n<size:10><color:#607D8B>RF-6.5</color></size>" as D41
  usecase "Consultar el resultado de la\nverificación del plan\n<size:10><color:#607D8B>RF-6.13</color></size>" as D42
}

DIR --> D35
DIR --> D36
DIR --> D37
DIR --> D38
DIR --> D39
DIR --> D40
DIR --> D41
DIR --> D42

@enduml
