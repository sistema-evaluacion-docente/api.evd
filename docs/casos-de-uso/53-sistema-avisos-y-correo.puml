@startuml cu-53-sistema-avisos-y-correo
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' Especificación de cada caso de uso: docs/casos-de-uso/README.md
' =============================================================================
title Casos de uso del Sistema — Notificaciones y correo institucional\nRequisitos RF-7.1, RF-7.2 y RF-6.12

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
' Descomenta la línea siguiente para aristas ortogonales (requiere Graphviz).
' skinparam linetype ortho
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Sistema" as SYS <<automático>> #FFF8E1
actor "Servidor de correo (SMTP)" as SMTP <<externo>> #FFF3E0

rectangle "Avisos del sistema" {
  usecase "CU-SIS-29 Notificar a la\ncontraparte cada transición del\nplan y del ciclo de evidencias\n<size:10><color:#607D8B>RF-6.12 · RF-7.1</color></size>" as S29 #FFFDE7
  usecase "CU-SIS-30 Alertar al director\ncuando una meta no se alcanzó\no reaparece la queja del plan\n<size:10><color:#607D8B>RF-6.13 · RF-7.1</color></size>" as S30 #FFFDE7
  usecase "CU-SIS-31 Enviar el correo\ninstitucional del evento del plan\n<size:10><color:#607D8B>RF-7.2</color></size>" as S31 #FFFDE7
  usecase "CU-SIS-32 Emitir la\nnotificación en tiempo real" as S32 #FFFDE7
  usecase "CU-SIS-33 Continuar la operación\naunque el aviso no se pueda entregar" as S33 #FFFDE7
}

SYS --> S29
SYS --> S30
SYS --> S31
SYS --> S32
SYS --> S33

S31 --> SMTP

S29 ..> S32 : <<include>>
S29 ..> S31 : <<include>>
S33 .> S31 : <<extend>>\n(el envío falla)

@enduml
