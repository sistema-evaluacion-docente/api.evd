@startuml cu-18-sistema-ciclo-de-planes
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' =============================================================================
title Casos de uso del Sistema — Automatismos del plan de mejoramiento\nRequisitos RF-4.4, RF-6.1, RF-6.11 y RF-6.12

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Sistema" as SYS <<automático>> #FFF8E1

rectangle "Lo que el sistema hace por su cuenta en el plan" {
  usecase "Sugerir candidatos a plan\n<size:10><color:#607D8B>RF-6.1 · RF-4.4</color></size>" as S21 #FFFDE7
  usecase "Componer el formato y\nrenderizarlo en PDF\n<size:10><color:#607D8B>RF-6.11</color></size>" as S25 #FFFDE7
  usecase "Avisar en el hilo que la\nevidencia fue rechazada\n<size:10><color:#607D8B>RF-6.12</color></size>" as S28 #FFFDE7
}

SYS --> S21
SYS --> S25
SYS --> S28

@enduml
