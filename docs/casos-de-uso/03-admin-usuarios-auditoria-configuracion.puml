@startuml cu-21-admin-usuarios-auditoria-configuracion
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' Especificación de cada caso de uso: docs/casos-de-uso/README.md
' =============================================================================
title Casos de uso del Administrador — Usuarios, auditoría y configuración institucional\nRequisitos RF-1.3, RF-6.1, RF-6.8 y RF-8.1 a RF-8.2

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
' Descomenta la línea siguiente para aristas ortogonales (requiere Graphviz).
' skinparam linetype ortho
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Administrador" as ADM

rectangle "Usuarios, auditoría y configuración institucional" {
  usecase "CU-ADM-09 Gestionar usuarios,\nsus roles y su estado\n<size:10><color:#607D8B>RF-1.3</color></size>" as A9
  usecase "CU-ADM-10 Consultar el\nhistorial de auditoría\n<size:10><color:#607D8B>RF-8.2</color></size>" as A10
  usecase "CU-ADM-11 Seguir los eventos de la\nbase de datos en modo depuración" as A11
  usecase "CU-ADM-12 Gestionar las\nconfiguraciones institucionales" as A12
  usecase "CU-ADM-13 Consultar el historial\nde cambios de una configuración" as A13
  usecase "CU-ADM-14 Fijar el umbral institucional\nque dispara el plan de mejoramiento\n<size:10><color:#607D8B>RF-6.1</color></size>" as A14
  usecase "CU-ADM-15 Reabrir el\nacta cerrada de un plan\n<size:10><color:#607D8B>RF-6.8</color></size>" as A15
}

ADM --> A9
ADM --> A10
ADM --> A11
ADM --> A12
ADM --> A13
ADM --> A14
ADM --> A15

A14 ..> A12 : <<include>>

@enduml
