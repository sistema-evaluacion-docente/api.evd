@startuml cu-15-docente-mis-planes
' =============================================================================
' Sistema de Evaluación Docente (SET) — UFPS
' Fuente: Tabla 36 (actores) y Tabla 37 (requisitos funcionales) del documento de
'         tesis, con la implementación de DistilUmbert-back y DistilUmbert-front.
' =============================================================================
title Casos de uso del Docente — Mis planes de mejoramiento\nRequisitos RF-6.2 y RF-6.11 a RF-6.13

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 13
skinparam TitleFontSize 17
skinparam TitleFontColor #0D47A1
skinparam ArrowColor #455A64
skinparam ArrowFontColor #546E7A
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 40
skinparam actor {
  BackgroundColor #ECEFF1
  BorderColor #37474F
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #102A43
}
skinparam rectangle {
  BackgroundColor #FAFCFD
  BorderColor #78909C
  FontColor #263238
  FontStyle bold
}

actor "Docente" as DOC

rectangle "Planes de mejoramiento del docente" {
  usecase "Consultar los planes propios\n<size:10><color:#607D8B>RF-6.2</color></size>" as C8
  usecase "Consultar el resultado de la\nverificación del plan\n<size:10><color:#607D8B>RF-6.13</color></size>" as C9
  usecase "Descargar el formato oficial del plan\n<size:10><color:#607D8B>RF-6.11</color></size>" as C10
  usecase "Consultar las solicitudes de evidencia\n<size:10><color:#607D8B>RF-6.12</color></size>" as C11
  usecase "Cargar la evidencia solicitada\n<size:10><color:#607D8B>RF-6.12</color></size>" as C12
  usecase "Eliminar una evidencia cargada\n<size:10><color:#607D8B>RF-6.12</color></size>" as C13
  usecase "Comentar en el hilo de la solicitud\n<size:10><color:#607D8B>RF-6.12</color></size>" as C14
  usecase "Descargar el archivo de una evidencia\n<size:10><color:#607D8B>RF-6.12</color></size>" as C15
}

DOC --> C8
DOC --> C9
DOC --> C10
DOC --> C11
DOC --> C12
DOC --> C13
DOC --> C14
DOC --> C15

@enduml
