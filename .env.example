# HugginFace models

HUGGINGFACE_RISK_MODEL=
HUGGINGFACE_CATEGORY_MODEL=

# Frontend

# Base pública de la SPA. Se usa para armar los enlaces de los correos, así que
# al desplegar hay que ponerla al dominio real: si se queda en localhost, los
# docentes reciben enlaces que no abren.
FRONTEND_URL=http://localhost:5173

MAIL_ENABLED=true
MAIL_BACKEND=console

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

MAIL_FROM=
MAIL_FROM_NAME=Sistema de Evaluación Docente · UFPS
